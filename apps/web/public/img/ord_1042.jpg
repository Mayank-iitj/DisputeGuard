<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="400" height="400">
  <defs>
    <linearGradient id="bg1042" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#f8fafc"/>
      <stop offset="100%" stop-color="#e2e8f0"/>
    </linearGradient>
    <linearGradient id="ceramic" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#e0f2fe"/>
      <stop offset="100%" stop-color="#bae6fd"/>
    </linearGradient>
  </defs>
  <rect width="400" height="400" fill="url(#bg1042)"/>
  <!-- Pour Over Dripper -->
  <polygon points="120,110 280,110 230,220 170,220" fill="url(#ceramic)" stroke="#0284c7" stroke-width="6"/>
  <!-- Handle -->
  <path d="M260,130 C310,130 310,190 240,200" fill="none" stroke="#0284c7" stroke-width="8" stroke-linecap="round"/>
  <!-- Base Server Jug -->
  <path d="M150,230 L250,230 L270,330 L130,330 Z" fill="#ffffff" stroke="#64748b" stroke-width="6"/>
  <!-- Spout -->
  <path d="M150,240 L120,245 L145,265" fill="#ffffff" stroke="#64748b" stroke-width="6"/>
  <text x="200" y="370" font-family="sans-serif" font-size="16" font-weight="bold" fill="#334155" text-anchor="middle">Ceramic Pour-Over Set</text>
</svg>
